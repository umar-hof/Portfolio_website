# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values you actually have.
# Everything here is OPTIONAL: the site builds and runs with none of it set.
# Never commit `.env.local` — it is gitignored.
# ---------------------------------------------------------------------------

# Public canonical origin. Used for metadata, canonical URLs, sitemap, robots.
# Example: https://umar-aidevs.com
NEXT_PUBLIC_SITE_URL=

# --- Lead storage (Supabase) -----------------------------------------------
# Create a project at https://supabase.com, then run `supabase/schema.sql`
# in the SQL editor. Both values are SERVER-ONLY and never reach the browser.
#
# SUPABASE_URL is the project URL: https://<project-ref>.supabase.co
# Use EITHER the service role key (server-side, bypasses RLS) OR the anon key
# (safe here — the schema grants anon INSERT-only on `leads`).
#
# If these are unset, the contact form still validates and returns success,
# but each submitted lead is logged to the server console instead of stored.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Analytics (optional) ---------------------------------------------------
# Both are inert until set. GTM takes precedence when both are present.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# --- Spam protection (optional) --------------------------------------------
# Any long random string. Upgrades the built-in rate limiter from in-memory
# (per server instance) to a signed, tamper-proof submission token.
CONTACT_RATE_LIMIT_SECRET=
